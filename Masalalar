// 1-masala
function boluvchilarSoni(n) {
    let soni = 0;
    for (let i = 1; i <= n; i++) {
        if (n % i === 0) {
            soni++;
        }
    }
    return soni;
}

// 2-masala
function sozniYashir(s) {
    if (s.length <= 2) {
        return s;
    }
    return s[0] + "*".repeat(s.length - 2) + s[s.length - 1];
}

// 3-masala
function juftlarniAjrat(arr) {
    let natija = [];
    for (let i = 0; i < arr.length; i++) {
        if (arr[i] % 2 === 0) {
            natija.push(arr[i]);
        }
    }
    return natija;
}

// 4-masala
function gapniTozala(s) {
    let matn = s.trim().replace(/\s+/g, " ");
    matn = matn[0].toUpperCase() + matn.slice(1);
    if (matn[matn.length - 1] !== ".") {
        matn += ".";
    }
    return matn;
}

// 5-masala
function pufakchaliSaralash(arr) {
    let natija = [...arr];
    for (let i = 0; i < natija.length - 1; i++) {
        for (let j = 0; j < natija.length - 1 - i; j++) {
            if (natija[j] > natija[j + 1]) {
                let vaqtinchalik = natija[j];
                natija[j] = natija[j + 1];
                natija[j + 1] = vaqtinchalik;
            }
        }
    }
    return natija;
}

console.log(boluvchilarSoni(12));        
console.log(boluvchilarSoni(13));      

console.log(sozniYashir("parol"));    
console.log(sozniYashir("ok"));         

console.log(juftlarniAjrat([1, 2, 3, 4, 5, 6])); 
console.log(juftlarniAjrat([7, 9]));             

console.log(gapniTozala("  salom  dunyo  "));   
console.log(gapniTozala("bu tayyor gap."));      

console.log(pufakchaliSaralash([5, 1, 4, 2, 8])); 
console.log(pufakchaliSaralash([3, -1, 3]));      
